<Window x:Class="ToolBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Tool Box">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Height="40">
      <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Spacing="10" VerticalAlignment="Center">
        <Image x:Name="Logo" Width="20" Height="20"/>
        <TextBlock Text="My Tool Box" FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Nav" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    PaneDisplayMode="Auto" OpenPaneLength="240" CompactPaneLength="48" CompactModeThresholdWidth="760" ExpandedModeThresholdWidth="1100" SelectionChanged="Nav_SelectionChanged" DisplayModeChanged="Nav_DisplayModeChanged">
      <NavigationView.AutoSuggestBox>
        <AutoSuggestBox x:Name="ToolSearch" PlaceholderText="Search tools" QueryIcon="Find" TextChanged="ToolSearch_TextChanged"/>
      </NavigationView.AutoSuggestBox>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Home" Tag="home"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItemHeader Content="Disk"/>
        <NavigationViewItem Content="Folder Size" Tag="foldersize"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Disk info" Tag="disk"><NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItemHeader Content="System"/>
        <NavigationViewItem Content="Hardware info" Tag="hw"><NavigationViewItem.Icon><FontIcon Glyph="&#xE950;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Temperatures" Tag="temps"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9CA;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Process monitor" Tag="proc"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Hosts file" Tag="hosts"><NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Environment &amp; PATH" Tag="env"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItemHeader Content="Network"/>
        <NavigationViewItem Content="Network adapters" Tag="adapters"><NavigationViewItem.Icon><FontIcon Glyph="&#xE839;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="DNS lookup" Tag="dns"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Ping" Tag="ping"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Traceroute" Tag="trace"><NavigationViewItem.Icon><FontIcon Glyph="&#xE707;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Subnet calculator" Tag="subnet"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8EF;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="IP scanner" Tag="ipscan"><NavigationViewItem.Icon><FontIcon Glyph="&#xE721;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Telnet / ports" Tag="telnet"><NavigationViewItem.Icon><FontIcon Glyph="&#xE756;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItemHeader Content="Developer"/>
        <NavigationViewItem Content="Hash text" Tag="hash"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Encrypt / decrypt" Tag="crypt"><NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Token &amp; UUID" Tag="token"><NavigationViewItem.Icon><FontIcon Glyph="&#xE192;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Base64 &amp; encoders" Tag="encode"><NavigationViewItem.Icon><FontIcon Glyph="&#xE943;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="JSON formatter" Tag="json"><NavigationViewItem.Icon><FontIcon Glyph="&#xE943;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="JWT decoder" Tag="jwt"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Timestamp" Tag="time"><NavigationViewItem.Icon><FontIcon Glyph="&#xE121;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Number base" Tag="base"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8EF;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Image to Base64" Tag="img64"><NavigationViewItem.Icon><FontIcon Glyph="&#xE91B;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Image to ICO" Tag="ico"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B9;"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <Grid>
        <Frame x:Name="PageFrame"/>
        <StackPanel x:Name="Loading" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <ProgressRing IsActive="True" Width="40" Height="40"/>
          <TextBlock x:Name="LoadingText" Text="Starting..." HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
        </StackPanel>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
